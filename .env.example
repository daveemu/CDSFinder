# PostgreSQL
POSTGRES_PASSWORD=change_me_in_production

# API encryption key (min 32 chars, used to encrypt SAP credentials at rest)
ENCRYPTION_KEY=replace-with-32-char-random-secret-here!

# Semantic search (optional — leave 'none' to disable)
EMBEDDING_PROVIDER=none
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://ollama:11434

# API server
PORT=3001
LOG_LEVEL=info
