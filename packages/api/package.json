    "drizzle-orm": "^0.33.0",
    "fastify": "^4.28.0",
    "postgres": "^3.4.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "drizzle-kit": "^0.24.0",
    "tsx": "^4.15.0",
    "typescript": "^5.4.5"
  }
}
