{
  "name": "@cdsfinder/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@cdsfinder/shared": "workspace:*",
